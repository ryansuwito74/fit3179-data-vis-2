{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "layer": [
    {
      "data": {
        "url": "data/maps/au-states-topo.json",
        "format": {
          "type": "topojson",
          "feature": "austates"
        }
      },
      "transform": [
        {
          "filter": "datum.id != 8"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#cbd5e1",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/chart6_phn_symbols.csv"
      },
      "params": [
        {
          "name": "phn_hover",
          "select": { "type": "point", "on": "pointerover", "clear": "pointerout" }
        }
      ],
      "mark": {
        "type": "circle"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "Total_Disorder_Persons",
          "type": "quantitative",
          "scale": {
            "range": [40, 750]
          },
          "legend": {
            "title": "Total Patients",
            "format": ",.0f"
          }
        },
        "color": {
          "field": "Severe_Pct",
          "type": "quantitative",
          "scale": {
            "scheme": "oranges"
          },
          "legend": {
            "title": "Severe Cases (%)"
          }
        },
        "stroke": {
          "condition": { "param": "phn_hover", "empty": false, "value": "#0f172a" },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": { "param": "phn_hover", "empty": false, "value": 2.5 },
          "value": 1
        },
        "opacity": {
          "condition": { "param": "phn_hover", "empty": false, "value": 1 },
          "value": 0.82
        },
        "tooltip": [
          {
            "field": "PHN_Name",
            "type": "nominal",
            "title": "PHN"
          },
          {
            "field": "Total_Disorder_Persons",
            "type": "quantitative",
            "title": "Total Patients",
            "format": ",.0f"
          },
          {
            "field": "Severe_Pct",
            "type": "quantitative",
            "title": "Severe Cases (%)",
            "format": ".1f"
          },
          {
            "field": "Any_Disorder_Pct",
            "type": "quantitative",
            "title": "Overall Prevalence (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}
