{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "data": {
    "url": "data/chart11_treemap_diagnoses.csv"
  },
  "facet": {
    "row": {
      "field": "disorder_group",
      "type": "nominal",
      "header": {
        "title": null,
        "labels": false
      }
    }
  },
  "spec": {
    "width": 250,
    "height": {
      "step": 21
    },
    "params": [
      {
        "name": "bar_hover",
        "select": {
          "type": "point",
          "on": "pointerover",
          "clear": "pointerout"
        }
      }
    ],
    "mark": {
      "type": "bar",
      "cornerRadiusEnd": 3
    },
    "encoding": {
      "y": {
        "field": "specific_diagnosis",
        "type": "nominal",
        "sort": "-x",
        "axis": {
          "title": null,
          "labelFontSize": 11,
          "labelLimit": 190
        }
      },
      "x": {
        "field": "persons_k",
        "type": "quantitative",
        "axis": {
          "title": "Affected Persons ('000)",
          "labelFontSize": 10
        }
      },
      "color": {
        "field": "disorder_group",
        "type": "nominal",
        "scale": {
          "domain": [
            "Anxiety Disorders",
            "Affective Disorders",
            "Substance Use Disorders"
          ],
          "range": [
            "#4f46e5",
            "#c2410c",
            "#0284c7"
          ]
        },
        "legend": {
          "title": "Disorder Family",
          "orient": "bottom",
          "direction": "horizontal",
          "columns": 3,
          "labelExpr": "replace(datum.label, ' Disorders', '')"
        }
      },
      "opacity": {
        "condition": {
          "param": "bar_hover",
          "empty": false,
          "value": 1
        },
        "value": 0.85
      },
      "tooltip": [
        {
          "field": "disorder_group",
          "title": "Broad Category"
        },
        {
          "field": "specific_diagnosis",
          "title": "Diagnosis"
        },
        {
          "field": "persons_k",
          "title": "Affected Persons ('000)",
          "format": ",.1f"
        },
        {
          "field": "proportion_pct",
          "title": "National Prevalence (%)",
          "format": ".1f"
        },
        {
          "field": "females_k",
          "title": "Females ('000)",
          "format": ",.1f"
        },
        {
          "field": "males_k",
          "title": "Males ('000)",
          "format": ",.1f"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "y": "independent"
    },
    "axis": {
      "y": "independent"
    }
  }
}
