{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 220,
  "data": {
    "url": "data/chart7_mbs_shifts.csv"
  },
  "encoding": {
    "y": {
      "field": "provider_type",
      "type": "nominal",
      "axis": {
        "title": "Provider Category",
        "labelLimit": 200
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#cbd5e1",
        "size": 4
      },
      "encoding": {
        "x": {
          "field": "male_rate_per_1k",
          "type": "quantitative",
          "axis": {
            "title": "Service Rate per 1,000 Population"
          }
        },
        "x2": {
          "field": "female_rate_per_1k"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 140
      },
      "encoding": {
        "x": {
          "field": "male_rate_per_1k",
          "type": "quantitative"
        },
        "color": {
          "value": "#0d9488"
        },
        "tooltip": [
          {
            "field": "provider_type",
            "title": "Provider"
          },
          {
            "field": "male_rate_per_1k",
            "title": "Male Rate (per 1k)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 140
      },
      "encoding": {
        "x": {
          "field": "female_rate_per_1k",
          "type": "quantitative"
        },
        "color": {
          "value": "#e11d48"
        },
        "tooltip": [
          {
            "field": "provider_type",
            "title": "Provider"
          },
          {
            "field": "female_rate_per_1k",
            "title": "Female Rate (per 1k)"
          }
        ]
      }
    }
  ]
}
