{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/chart2_butterfly_age_sex.csv"
  },
  "transform": [
    {
      "calculate": "datum.sex == 'Female' ? -datum.anxiety_pct : datum.anxiety_pct",
      "as": "signed_rate"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#cbd5e1",
        "strokeWidth": 1.5,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "axis": {
            "title": "Age Cohort"
          },
          "sort": [
            "16–24",
            "25–34",
            "35–44",
            "45–54",
            "55–64",
            "65–74",
            "75–85"
          ]
        },
        "x": {
          "field": "signed_rate",
          "type": "quantitative",
          "scale": {
            "domain": [
              -48,
              48
            ]
          },
          "axis": {
            "title": "← Female (%) · Male (%) →",
            "format": ".0f",
            "labelExpr": "abs(datum.value)"
          }
        },
        "color": {
          "field": "sex",
          "type": "nominal",
          "scale": {
            "domain": [
              "Female",
              "Male"
            ],
            "range": [
              "#0d9488",
              "#d97706"
            ]
          },
          "legend": {
            "title": "Gender",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "age_group",
            "type": "nominal",
            "title": "Age Cohort"
          },
          {
            "field": "sex",
            "type": "nominal",
            "title": "Gender"
          },
          {
            "field": "anxiety_pct",
            "type": "quantitative",
            "title": "Anxiety Prevalence (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 500,
        "fill": "#475569",
        "align": {
          "expr": "datum.sex == 'Female' ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.sex == 'Female' ? -6 : 6"
        }
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "16–24",
            "25–34",
            "35–44",
            "45–54",
            "55–64",
            "65–74",
            "75–85"
          ]
        },
        "x": {
          "field": "signed_rate",
          "type": "quantitative"
        },
        "text": {
          "field": "anxiety_pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ]
}
