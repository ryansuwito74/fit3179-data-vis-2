{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/chart4_age_distress.csv"
  },
  "params": [
    {
      "name": "distress_hover",
      "select": {
        "type": "point",
        "fields": ["distress_level"],
        "on": "pointerover",
        "clear": "pointerout"
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 3,
    "cornerRadiusTopRight": 3
  },
  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "sort": [
        "16–24",
        "25–34",
        "35–44",
        "45–54",
        "55–64",
        "65–74",
        "75–85"
      ],
      "axis": {
        "title": "Age Cohort",
        "labelAngle": 0,
        "labelFontSize": 11,
        "titleFontSize": 12,
        "grid": false
      }
    },
    "xOffset": {
      "field": "distress_level",
      "sort": [
        "Low",
        "Moderate",
        "High",
        "Very High"
      ]
    },
    "y": {
      "field": "percentage",
      "type": "quantitative",
      "scale": {
        "domain": [0, 80]
      },
      "axis": {
        "title": "Cohort Share (%)",
        "format": ".0f",
        "labelFontSize": 11,
        "titleFontSize": 12
      }
    },
    "color": {
      "field": "distress_level",
      "type": "nominal",
      "scale": {
        "domain": [
          "Low",
          "Moderate",
          "High",
          "Very High"
        ],
        "range": [
          "#bae6fd",
          "#7dd3fc",
          "#38bdf8",
          "#0369a1"
        ]
      },
      "legend": {
        "title": "Distress Level (K10)",
        "orient": "bottom",
        "direction": "horizontal"
      }
    },
    "opacity": {
      "condition": {
        "param": "distress_hover",
        "value": 1
      },
      "value": 0.35
    },
    "tooltip": [
      {
        "field": "age_group",
        "type": "nominal",
        "title": "Age Cohort"
      },
      {
        "field": "distress_level",
        "type": "nominal",
        "title": "K10 Distress Level"
      },
      {
        "field": "percentage",
        "type": "quantitative",
        "title": "Cohort Share (%)",
        "format": ".1f"
      },
      {
        "field": "count_k",
        "type": "quantitative",
        "title": "Est. Population ('000)",
        "format": ",.1f"
      }
    ]
  }
}
