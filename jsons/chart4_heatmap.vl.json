{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Over 1 in 4 Young Australians Experience High or Very High Psychological Distress",
    "subtitle": "Share of age group across Kessler Psychological Distress Scale (K10) severity categories (%), 2020–2022",
    "anchor": "start"
  },
  "width": "container",
  "height": 280,
  "data": { "url": "data/chart4_age_distress.csv" },
  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "sort": ["16–24", "25–34", "35–44", "45–54", "55–64", "65–74", "75–85"],
      "axis": { "title": "Age Group", "labelAngle": 0 }
    },
    "y": {
      "field": "distress_level",
      "type": "ordinal",
      "sort": ["Very High", "High", "Moderate", "Low"],
      "axis": { "title": "Distress Level (K10)" }
    }
  },
  "layer": [
    {
      "mark": { "type": "rect", "stroke": "#ffffff", "strokeWidth": 2 },
      "encoding": {
        "color": {
          "field": "percentage",
          "type": "quantitative",
          "scale": { "scheme": "tealblues" },
          "legend": { "title": "Share of Cohort (%)" }
        },
        "tooltip": [
          { "field": "age_group", "type": "ordinal", "title": "Age Group" },
          { "field": "distress_level", "type": "ordinal", "title": "Distress Level" },
          { "field": "percentage", "type": "quantitative", "title": "Proportion (%)", "format": ".1f" },
          { "field": "count_k", "type": "quantitative", "title": "Persons ('000)", "format": ",.1f" }
        ]
      }
    },
    {
      "mark": { "type": "text", "baseline": "middle", "fontSize": 11, "fontWeight": 600 },
      "encoding": {
        "text": { "field": "percentage", "type": "quantitative", "format": ".1f" },
        "color": {
          "condition": { "test": "datum.percentage > 40", "value": "#ffffff" },
          "value": "#0f172a"
        }
      }
    }
  ]
}