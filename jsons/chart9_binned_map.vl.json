{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "layer": [
    {
      "data": {
        "url": "data/maps/au-states-topo.json",
        "format": {
          "type": "topojson",
          "feature": "austates"
        }
      },
      "transform": [
        {
          "filter": "datum.id != 8"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#94a3b8",
        "strokeWidth": 0.9
      }
    },
    {
      "data": {
        "url": "data/chart9_sa4_binned_map.csv"
      },
      "transform": [
        {
          "bin": {
            "step": 1.5
          },
          "field": "lon",
          "as": [
            "lon_bin",
            "lon_bin_end"
          ]
        },
        {
          "bin": {
            "step": 1.5
          },
          "field": "lat",
          "as": [
            "lat_bin",
            "lat_bin_end"
          ]
        },
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "prevalence_pct",
              "as": "mean_prevalence"
            },
            {
              "op": "sum",
              "field": "patients_count",
              "as": "total_patients"
            },
            {
              "op": "count",
              "as": "region_count"
            }
          ],
          "groupby": [
            "lon_bin",
            "lon_bin_end",
            "lat_bin",
            "lat_bin_end"
          ]
        },
        {
          "calculate": "(datum.lon_bin + datum.lon_bin_end) / 2",
          "as": "center_lon"
        },
        {
          "calculate": "(datum.lat_bin + datum.lat_bin_end) / 2",
          "as": "center_lat"
        }
      ],
      "params": [
        {
          "name": "grid_hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "square",
        "size": 260
      },
      "encoding": {
        "longitude": {
          "field": "center_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "center_lat",
          "type": "quantitative"
        },
        "color": {
          "field": "mean_prevalence",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              6,
              8,
              10,
              12
            ],
            "range": [
              "#d8b4fe",
              "#c084fc",
              "#a855f7",
              "#7e22ce",
              "#3b0764"
            ]
          },
          "legend": {
            "title": "Binned Prevalence Rate (%)",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "stroke": {
          "condition": {
            "param": "grid_hover",
            "empty": false,
            "value": "#0f172a"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "param": "grid_hover",
            "empty": false,
            "value": 2.5
          },
          "value": 1.2
        },
        "opacity": {
          "condition": {
            "param": "grid_hover",
            "empty": false,
            "value": 1
          },
          "value": 0.95
        },
        "tooltip": [
          {
            "field": "mean_prevalence",
            "title": "Mean Prevalence (%)",
            "format": ".2f"
          },
          {
            "field": "total_patients",
            "title": "Total Diagnosed Patients",
            "format": ",.0f"
          },
          {
            "field": "region_count",
            "title": "SA4 Regions Binned"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 144.25,
            "lat": -37.25,
            "label": "Central Vic Binned Peak (>12%)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -16,
        "dy": -10,
        "fontSize": 10.5,
        "fontWeight": 700,
        "fill": "#3b0764"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}
