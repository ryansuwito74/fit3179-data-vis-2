{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "layer": [
    {
      "data": {
        "url": "data/maps/au-states-topo.json",
        "format": {
          "type": "topojson",
          "feature": "austates"
        }
      },
      "transform": [
        {
          "filter": "datum.id != 8"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#94a3b8",
        "strokeWidth": 0.9
      }
    },
    {
      "data": {
        "url": "data/binned_map_sa4_prevalence.csv"
      },
      "transform": [
        {
          "bin": {
            "step": 1.5
          },
          "field": "lon",
          "as": [
            "lon_bin",
            "lon_bin_end"
          ]
        },
        {
          "bin": {
            "step": 1.5
          },
          "field": "lat",
          "as": [
            "lat_bin",
            "lat_bin_end"
          ]
        },
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "prevalence_pct",
              "as": "mean_prevalence"
            },
            {
              "op": "sum",
              "field": "patients_count",
              "as": "total_patients"
            },
            {
              "op": "count",
              "as": "region_count"
            }
          ],
          "groupby": [
            "lon_bin",
            "lon_bin_end",
            "lat_bin",
            "lat_bin_end"
          ]
        },
        {
          "calculate": "(datum.lon_bin + datum.lon_bin_end) / 2",
          "as": "center_lon"
        },
        {
          "calculate": "(datum.lat_bin + datum.lat_bin_end) / 2",
          "as": "center_lat"
        }
      ],
      "params": [
        {
          "name": "grid_hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "square",
        "size": 260
      },
      "encoding": {
        "longitude": {
          "field": "center_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "center_lat",
          "type": "quantitative"
        },
        "color": {
          "field": "mean_prevalence",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              6,
              8,
              10,
              12
            ],
            "range": [
              "#d8b4fe",
              "#c084fc",
              "#a855f7",
              "#7e22ce",
              "#3b0764"
            ]
          },
          "legend": {
            "title": "Binned Prevalence Rate (%)",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "stroke": {
          "condition": {
            "param": "grid_hover",
            "empty": false,
            "value": "#0f172a"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "param": "grid_hover",
            "empty": false,
            "value": 2.5
          },
          "value": 1.2
        },
        "opacity": {
          "condition": {
            "param": "grid_hover",
            "empty": false,
            "value": 1
          },
          "value": 0.95
        },
        "tooltip": [
          {
            "field": "mean_prevalence",
            "title": "Mean Prevalence (%)",
            "format": ".2f"
          },
          {
            "field": "total_patients",
            "title": "Total Diagnosed Patients",
            "format": ",.0f"
          },
          {
            "field": "region_count",
            "title": "SA4 Regions Binned"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 138.5,
            "lat": -40.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "text": [
          "Central Vic Binned",
          "Peak (>12%)"
        ],
        "align": "right",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 13,
        "fill": "#3b0764"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 139.2,
            "lat": -40.2,
            "lon2": 143.2,
            "lat2": -37.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#4c1d95",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 143.4,
            "lat": -37.3,
            "arrow": "↗"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 700,
        "fill": "#4c1d95",
        "baseline": "middle",
        "align": "center"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "arrow",
          "type": "nominal"
        }
      }
    }
  ]
}
