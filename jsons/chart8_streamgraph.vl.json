{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/chart8_streamgraph_mbs_services.csv"
  },
  "params": [
    {
      "name": "stream_hover",
      "select": {
        "type": "point",
        "fields": ["provider_type"],
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone"
  },
  "encoding": {
    "x": {
      "field": "year_date",
      "type": "temporal",
      "axis": {
        "title": "Financial Year",
        "format": "%Y",
        "tickCount": 9,
        "grid": false
      }
    },
    "y": {
      "field": "services",
      "type": "quantitative",
      "stack": "center",
      "axis": null
    },
    "color": {
      "field": "provider_type",
      "type": "nominal",
      "scale": {
        "domain": [
          "General practitioners",
          "Other psychologists",
          "Clinical psychologists",
          "Psychiatrists",
          "Other allied health providers"
        ],
        "range": [
          "#0d9488",
          "#d97706",
          "#e11d48",
          "#6366f1",
          "#64748b"
        ]
      },
      "legend": {
        "title": "Provider Category",
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 3
      }
    },
    "opacity": {
      "condition": {
        "param": "stream_hover",
        "value": 1
      },
      "value": 0.35
    },
    "tooltip": [
      {
        "field": "financial_year",
        "type": "nominal",
        "title": "Financial Year"
      },
      {
        "field": "provider_type",
        "type": "nominal",
        "title": "Provider Type"
      },
      {
        "field": "services",
        "type": "quantitative",
        "title": "Annual Consultations",
        "format": ",.0f"
      }
    ]
  }
}
