{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/chart8_streamgraph_services.csv"
  },
  "mark": "area",
  "encoding": {
    "x": {
      "field": "year_date",
      "type": "temporal",
      "axis": {
        "title": "Financial Year",
        "format": "%Y",
        "tickCount": 10
      }
    },
    "y": {
      "field": "services",
      "type": "quantitative",
      "stack": "center",
      "axis": null
    },
    "color": {
      "field": "provider_type",
      "type": "nominal",
      "scale": {
        "scheme": "tableau10"
      },
      "legend": {
        "title": "Provider Type",
        "orient": "right"
      }
    },
    "tooltip": [
      {
        "field": "financial_year",
        "type": "nominal",
        "title": "Year"
      },
      {
        "field": "provider_type",
        "type": "nominal",
        "title": "Provider"
      },
      {
        "field": "services",
        "type": "quantitative",
        "title": "Consultations",
        "format": ",.0f"
      }
    ]
  }
}
