{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Northern Territory and ACT Record Highest 12-Month Disorder Rates",
    "subtitle": "Proportion of persons aged 16–85 with an active 12-month mental disorder by state/territory (%), 2020–2022",
    "anchor": "start"
  },
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/maps/au-states-topo.json",
    "format": { "type": "topojson", "feature": "austates" }
  },
  "transform": [
    {
      "filter": "datum.id != 8"
    },
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": { "url": "data/chart1_state_prevalence.csv" },
        "key": "State",
        "fields": ["Any_12m_Disorder_Pct", "Abbrev"]
      }
    }
  ],
  "projection": { "type": "equirectangular" },
  "mark": { "type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1 },
  "encoding": {
    "color": {
      "field": "Any_12m_Disorder_Pct",
      "type": "quantitative",
      "scale": { "scheme": "teals" },
      "legend": { "title": "Disorder Rate (%)", "orient": "right" }
    },
    "tooltip": [
      { "field": "properties.STATE_NAME", "type": "nominal", "title": "State" },
      { "field": "Any_12m_Disorder_Pct", "type": "quantitative", "title": "Prevalence (%)", "format": ".1f" }
    ]
  }
}