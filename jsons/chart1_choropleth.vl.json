{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/maps/au-states-topo.json",
    "format": {
      "type": "topojson",
      "feature": "austates"
    }
  },
  "transform": [
    {
      "filter": "datum.id != 8"
    },
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/chart1_state_prevalence.csv"
        },
        "key": "State",
        "fields": [
          "Any_12m_Disorder_Pct",
          "Abbrev"
        ]
      }
    }
  ],
  "projection": {
    "type": "equirectangular"
  },
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "Any_12m_Disorder_Pct",
      "type": "quantitative",
      "scale": {
        "scheme": "teals"
      },
      "legend": {
        "title": "Disorder Rate (%)",
        "orient": "bottom",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "Any_12m_Disorder_Pct",
        "type": "quantitative",
        "title": "Prevalence (%)",
        "format": ".1f"
      }
    ]
  }
}
