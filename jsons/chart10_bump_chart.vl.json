{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/chart10_bump_ranks.csv"
  },
  "encoding": {
    "x": {
      "field": "financial_year",
      "type": "ordinal",
      "axis": {
        "title": "Financial Year",
        "labelAngle": -45
      }
    },
    "y": {
      "field": "rank",
      "type": "ordinal",
      "axis": {
        "title": "Demand Rank (1 = Highest)"
      }
    },
    "color": {
      "field": "age_group",
      "type": "nominal",
      "scale": {
        "scheme": "set2"
      },
      "legend": {
        "title": "Age Cohort",
        "orient": "bottom"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 4
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100
      }
    }
  ]
}
