{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "layer": [
    {
      "data": {
        "values": [
          {
            "start_yr": "2020–21",
            "end_yr": "2021–22"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#f1f5f9",
        "opacity": 0.7
      },
      "encoding": {
        "x": {
          "field": "start_yr",
          "type": "ordinal"
        },
        "x2": {
          "field": "end_yr"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x_pos": "2020–21",
            "y_pos": 6,
            "label": "COVID-19 Surge"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": 18,
        "fontSize": 10,
        "fontWeight": 600,
        "fill": "#64748b"
      },
      "encoding": {
        "x": {
          "field": "x_pos",
          "type": "ordinal"
        },
        "y": {
          "field": "y_pos",
          "type": "ordinal",
          "scale": {
            "domain": [1, 2, 3, 4, 5, 6]
          }
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/chart10_bump_age_ranks.csv",
        "format": {
          "type": "csv",
          "parse": {
            "rank": "number",
            "service_rate_per_1k": "number"
          }
        }
      },
      "params": [
        {
          "name": "cohort_hover",
          "select": {
            "type": "point",
            "fields": [
              "age_group"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "axis": {
            "title": "Financial Year",
            "labelAngle": -35,
            "labelFontSize": 11,
            "grid": false
          }
        },
        "y": {
          "field": "rank",
          "type": "ordinal",
          "scale": {
            "domain": [1, 2, 3, 4, 5, 6]
          },
          "axis": {
            "title": "Demand Rank (1 = Highest Demand)",
            "labelFontSize": 11,
            "gridColor": "#e2e8f0",
            "gridDash": [
              3,
              3
            ]
          }
        },
        "color": {
          "field": "age_group",
          "type": "nominal",
          "scale": {
            "domain": [
              "12–17 years",
              "18–24 years",
              "25–34 years",
              "35–44 years",
              "45–54 years",
              "55–64 years"
            ],
            "range": [
              "#ec4899",
              "#8b5cf6",
              "#06b6d4",
              "#f59e0b",
              "#10b981",
              "#64748b"
            ]
          },
          "legend": {
            "title": "Age Cohort",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 3
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "cohort_hover",
            "empty": false,
            "value": 4.5
          },
          "value": 2.5
        },
        "opacity": {
          "condition": {
            "param": "cohort_hover",
            "empty": false,
            "value": 1
          },
          "value": 0.82
        }
      }
    },
    {
      "data": {
        "url": "data/chart10_bump_age_ranks.csv",
        "format": {
          "type": "csv",
          "parse": {
            "rank": "number",
            "service_rate_per_1k": "number"
          }
        }
      },
      "mark": {
        "type": "point",
        "filled": true
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal"
        },
        "y": {
          "field": "rank",
          "type": "ordinal",
          "scale": {
            "domain": [1, 2, 3, 4, 5, 6]
          }
        },
        "color": {
          "field": "age_group",
          "type": "nominal",
          "scale": {
            "domain": [
              "12–17 years",
              "18–24 years",
              "25–34 years",
              "35–44 years",
              "45–54 years",
              "55–64 years"
            ],
            "range": [
              "#ec4899",
              "#8b5cf6",
              "#06b6d4",
              "#f59e0b",
              "#10b981",
              "#64748b"
            ]
          }
        },
        "size": {
          "condition": {
            "param": "cohort_hover",
            "empty": false,
            "value": 120
          },
          "value": 65
        },
        "opacity": {
          "condition": {
            "param": "cohort_hover",
            "empty": false,
            "value": 1
          },
          "value": 0.9
        },
        "tooltip": [
          {
            "field": "financial_year",
            "title": "Financial Year"
          },
          {
            "field": "age_group",
            "title": "Age Cohort"
          },
          {
            "field": "rank",
            "title": "Demand Rank"
          },
          {
            "field": "service_rate_per_1k",
            "title": "Services per 1k Pop",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "financial_year": "2021–22",
            "rank": 1,
            "label": "Youth Peak: 910 / 1k pop"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -14,
        "fontSize": 11,
        "fontWeight": 700,
        "fill": "#6b21a8"
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal"
        },
        "y": {
          "field": "rank",
          "type": "ordinal",
          "scale": {
            "domain": [1, 2, 3, 4, 5, 6]
          }
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
