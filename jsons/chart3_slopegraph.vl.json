{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Diagnosed Mental Health Conditions Nearly Tripled Among Young Adults Since 2009",
    "subtitle": "Percentage point shift in reported long-term mental health conditions by age bracket (2009 vs. 2021)",
    "anchor": "start"
  },
  "width": "container",
  "height": 340,
  "data": { "url": "data/chart3_slopegraph_shift.csv" },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "scale": { "padding": 0.35 },
      "axis": {
        "title": "Census Year",
        "labelAngle": 0,
        "labelPadding": 10,
        "grid": false
      }
    },
    "y": {
      "field": "prevalence_pct",
      "type": "quantitative",
      "scale": { "domain": [0, 30] },
      "axis": { "title": "Prevalence (%)", "format": ".0f", "tickCount": 6 }
    },
    "color": {
      "field": "age_group",
      "type": "nominal",
      "scale": {
        "domain": ["15–17", "18–24", "25–34", "35–44", "45–54", "55–64", "65–74", "75–84"],
        "range": ["#e11d48", "#0d9488", "#d97706", "#6366f1", "#0891b2", "#8b5cf6", "#64748b", "#94a3b8"]
      },
      "legend": { "title": "Age Cohort", "orient": "right" }
    },
    "tooltip": [
      { "field": "age_group", "type": "nominal", "title": "Age Cohort" },
      { "field": "year", "type": "ordinal", "title": "Census Year" },
      { "field": "prevalence_pct", "type": "quantitative", "title": "Prevalence (%)", "format": ".1f" },
      { "field": "shift_pp", "type": "nominal", "title": "10-Year Drift" }
    ]
  },
  "layer": [
    {
      "mark": { "type": "line" },
      "encoding": {
        "strokeWidth": {
          "condition": { "param": "hover_cohort", "empty": false, "value": 4 },
          "value": 2.5
        },
        "opacity": {
          "condition": { "param": "hover_cohort", "value": 1 },
          "value": 0.25
        }
      }
    },
    {
      "params": [
        {
          "name": "hover_cohort",
          "select": { "type": "point", "fields": ["age_group"], "on": "pointerover", "clear": "pointerout" }
        }
      ],
      "mark": { "type": "point", "filled": true },
      "encoding": {
        "size": {
          "condition": { "param": "hover_cohort", "empty": false, "value": 140 },
          "value": 70
        },
        "opacity": {
          "condition": { "param": "hover_cohort", "value": 1 },
          "value": 0.3
        }
      }
    },
    {
      "transform": [
        { "filter": "datum.year == 2021" },
        {
          "calculate": "datum.prevalence_pct + '% (' + datum.shift_pp + ')'",
          "as": "label_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "text": { "field": "label_text", "type": "nominal" },
        "opacity": {
          "condition": { "param": "hover_cohort", "value": 1 },
          "value": 0.35
        }
      }
    }
  ]
}