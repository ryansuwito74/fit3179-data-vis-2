{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/chart3_slopegraph_shift.csv"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "scale": {
        "padding": 0.35
      },
      "axis": {
        "title": "Census Year",
        "labelAngle": 0,
        "labelPadding": 10,
        "labelFontSize": 11,
        "grid": false
      }
    },
    "y": {
      "field": "prevalence_pct",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          30
        ]
      },
      "axis": {
        "title": "Prevalence (%)",
        "format": ".0f",
        "tickCount": 6,
        "gridColor": "#f1f5f9",
        "labelFontSize": 10
      }
    },
    "color": {
      "field": "age_group",
      "type": "nominal",
      "scale": {
        "domain": [
          "15–17",
          "18–24",
          "25–34",
          "35–44",
          "45–54",
          "55–64",
          "65–74",
          "75–84"
        ],
        "range": [
          "#f472b6",
          "#db2777",
          "#f97316",
          "#8b5cf6",
          "#0284c7",
          "#475569",
          "#57534e",
          "#78716c"
        ]
      },
      "legend": {
        "title": "Age Cohort",
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 4
      }
    },
    "tooltip": [
      {
        "field": "age_group",
        "type": "nominal",
        "title": "Age Cohort"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Census Year"
      },
      {
        "field": "prevalence_pct",
        "type": "quantitative",
        "title": "Prevalence (%)",
        "format": ".1f"
      },
      {
        "field": "shift_pp",
        "type": "nominal",
        "title": "10-Year Drift"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line"
      },
      "encoding": {
        "strokeWidth": {
          "condition": [
            {
              "param": "hover_cohort",
              "empty": false,
              "value": 4.5
            },
            {
              "test": "datum.age_group === '18–24' || datum.age_group === '15–17'",
              "value": 3.5
            }
          ],
          "value": 1.8
        },
        "opacity": {
          "condition": [
            {
              "param": "hover_cohort",
              "empty": false,
              "value": 1
            },
            {
              "test": "datum.age_group === '18–24' || datum.age_group === '15–17'",
              "value": 1
            }
          ],
          "value": 0.55
        }
      }
    },
    {
      "params": [
        {
          "name": "hover_cohort",
          "select": {
            "type": "point",
            "fields": [
              "age_group"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true
      },
      "encoding": {
        "size": {
          "condition": [
            {
              "param": "hover_cohort",
              "empty": false,
              "value": 140
            },
            {
              "test": "datum.age_group === '18–24' || datum.age_group === '15–17'",
              "value": 90
            }
          ],
          "value": 55
        },
        "opacity": {
          "condition": [
            {
              "param": "hover_cohort",
              "empty": false,
              "value": 1
            },
            {
              "test": "datum.age_group === '18–24' || datum.age_group === '15–17'",
              "value": 1
            }
          ],
          "value": 0.6
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2021"
        },
        {
          "calculate": "datum.prevalence_pct + '% (' + datum.shift_pp + ')'",
          "as": "label_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": {
          "expr": "datum.age_group === '45–54' ? -8 : (datum.age_group === '15–17' ? -6 : (datum.age_group === '55–64' ? 6 : (datum.age_group === '35–44' ? 8 : 0)))"
        },
        "fontSize": 11,
        "fontWeight": 700,
        "fill": "#0f172a"
      },
      "encoding": {
        "text": {
          "field": "label_text",
          "type": "nominal"
        },
        "opacity": {
          "condition": [
            {
              "param": "hover_cohort",
              "empty": false,
              "value": 1
            },
            {
              "test": "datum.age_group === '18–24' || datum.age_group === '15–17'",
              "value": 1
            }
          ],
          "value": 0.7
        }
      }
    }
  ]
}
