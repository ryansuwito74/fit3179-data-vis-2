{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/chart5_parallel_clinical_profile.csv"
  },
  "transform": [
    {
      "fold": [
        "Active 12m Disorder (%)",
        "High/Very High Distress (%)",
        "Lifetime Suicidal Ideation (%)",
        "Lifetime Self-Harm (%)",
        "Physical Comorbidity (%)"
      ],
      "as": [
        "metric",
        "prevalence_pct"
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "metric",
      "type": "nominal",
      "axis": {
        "title": null,
        "labelFontSize": 11,
        "labelFontWeight": 600,
        "labelColor": "#1e293b",
        "grid": false
      }
    },
    "yOffset": {
      "field": "State",
      "type": "nominal",
      "sort": [
        "Queensland",
        "Western Australia",
        "South Australia",
        "Victoria",
        "New South Wales"
      ]
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "state_hover",
          "select": {
            "type": "point",
            "fields": [
              "State"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "height": 9
      },
      "encoding": {
        "x": {
          "field": "prevalence_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              45
            ]
          },
          "axis": {
            "title": "Prevalence Rate (%)",
            "labelFontSize": 10,
            "titleFontSize": 11,
            "gridColor": "#f1f5f9"
          }
        },
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {
            "domain": [
              "Queensland",
              "Western Australia",
              "South Australia",
              "Victoria",
              "New South Wales"
            ],
            "range": [
              "#b45309",
              "#ca8a04",
              "#a16207",
              "#1e3a8a",
              "#2563eb"
            ]
          },
          "legend": {
            "title": "State",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "opacity": {
          "condition": {
            "param": "state_hover",
            "empty": false,
            "value": 1
          },
          "value": 0.85
        },
        "tooltip": [
          {
            "field": "State",
            "title": "State"
          },
          {
            "field": "metric",
            "title": "Clinical Indicator"
          },
          {
            "field": "prevalence_pct",
            "title": "Prevalence (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 9.5,
        "fontWeight": 600,
        "fill": "#b45309"
      },
      "encoding": {
        "x": {
          "field": "prevalence_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "prevalence_pct",
          "type": "quantitative",
          "format": ".1f"
        },
        "opacity": {
          "condition": {
            "test": "datum.State === 'Queensland'",
            "value": 1
          },
          "value": 0
        }
      }
    }
  ]
}
