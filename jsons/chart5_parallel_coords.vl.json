{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/chart5_parallel_clinical_profile.csv"
  },
  "transform": [
    {
      "fold": [
        "Active 12m Disorder (%)",
        "High/Very High Distress (%)",
        "Lifetime Suicidal Ideation (%)",
        "Lifetime Self-Harm (%)",
        "Physical Comorbidity (%)"
      ],
      "as": [
        "metric",
        "raw_value"
      ]
    },
    {
      "calculate": "toNumber(datum.raw_value)",
      "as": "raw_value"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "raw_value",
          "as": "min_val"
        },
        {
          "op": "max",
          "field": "raw_value",
          "as": "max_val"
        }
      ],
      "groupby": [
        "metric"
      ]
    },
    {
      "calculate": "(datum.raw_value - datum.min_val) / (datum.max_val - datum.min_val)",
      "as": "norm_value"
    }
  ],
  "encoding": {
    "x": {
      "field": "metric",
      "type": "nominal",
      "scale": {
        "padding": 0.15
      },
      "axis": {
        "title": null,
        "labelAngle": -15,
        "labelFontWeight": 600,
        "labelLimit": 160,
        "orient": "bottom"
      }
    },
    "y": {
      "field": "norm_value",
      "type": "quantitative",
      "scale": {
        "domain": [
          -0.05,
          1.05
        ]
      },
      "axis": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#cbd5e1",
        "strokeWidth": 1.5,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "nominal"
        },
        "y": {
          "datum": 0
        },
        "y2": {
          "datum": 1
        }
      }
    },
    {
      "params": [
        {
          "name": "state_hover",
          "select": {
            "type": "point",
            "fields": [
              "State"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "line"
      },
      "encoding": {
        "detail": {
          "field": "State",
          "type": "nominal"
        },
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {
            "domain": [
              "Queensland",
              "Western Australia",
              "South Australia",
              "Victoria",
              "New South Wales"
            ],
            "range": [
              "#e11d48",
              "#d97706",
              "#0d9488",
              "#6366f1",
              "#64748b"
            ]
          },
          "legend": {
            "title": "State",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "state_hover",
            "empty": false,
            "value": 4
          },
          "value": 2.5
        },
        "opacity": {
          "condition": {
            "param": "state_hover",
            "value": 1
          },
          "value": 0.2
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true
      },
      "encoding": {
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {
            "domain": [
              "Queensland",
              "Western Australia",
              "South Australia",
              "Victoria",
              "New South Wales"
            ],
            "range": [
              "#e11d48",
              "#d97706",
              "#0d9488",
              "#6366f1",
              "#64748b"
            ]
          }
        },
        "size": {
          "condition": {
            "param": "state_hover",
            "empty": false,
            "value": 140
          },
          "value": 75
        },
        "opacity": {
          "condition": {
            "param": "state_hover",
            "value": 1
          },
          "value": 0.3
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "metric",
            "type": "nominal",
            "title": "Clinical Metric"
          },
          {
            "field": "raw_value",
            "type": "quantitative",
            "title": "Actual Prevalence (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}
